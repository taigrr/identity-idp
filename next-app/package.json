    "@aws-sdk/client-sns": "^3.1014.0",
    "@aws-sdk/client-sqs": "^3.1014.0",
    "@neondatabase/serverless": "^1.0.2",
    "@react-email/components": "^1.0.10",
    "@simplewebauthn/server": "^13.3.0",
    "@simplewebauthn/types": "^12.0.0",
    "@types/qrcode": "^1.5.6",
    "bullmq": "^5.71.0",
    "drizzle-orm": "^0.39.3",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "msgpack-lite": "^0.1.26",
    "next": "^16.2.0",
    "next-intl": "^4.8.3",
    "otpauth": "^9.5.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-email": "^5.2.10",
    "scrypt-js": "^3.0.1",
    "yaml": "^2.8.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
