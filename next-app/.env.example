# Local development environment variables
# Copy to .env.local and fill in values

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://idp_admin:idp_dev_password@localhost:5432/identity_idp

# Redis (matches docker-compose.yml)
REDIS_URL=redis://:idp_dev_redis_password@localhost:6379

# Next.js
NODE_ENV=development
PORT=3000

# KMS - use local mock for development
# In production, this comes from AWS
KMS_KEY_ID=local-dev-key

# Session secret (generate with: openssl rand -base64 32)
SESSION_SECRET=change-me-in-production

# SAML/OIDC (for local testing)
SAML_ENTITY_ID=https://localhost:3000
OIDC_ISSUER=https://localhost:3000

# Feature flags
ENABLE_STRIPE_DOCV=true
ENABLE_SOCURE_DOCV=true
